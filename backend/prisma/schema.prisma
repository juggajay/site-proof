model Document {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  lotId            String?   @map("lot_id")
  documentType     String    @map("document_type")
  category         String?
  filename         String
  fileUrl          String    @map("file_url")
  fileSize         Int?      @map("file_size")
  mimeType         String?   @map("mime_type")
  uploadedById     String?   @map("uploaded_by")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  gpsLatitude      Decimal?  @map("gps_latitude")
  gpsLongitude     Decimal?  @map("gps_longitude")
  captureTimestamp DateTime? @map("capture_timestamp")
  aiClassification String?   @map("ai_classification")
  caption          String?
  tags             String? // Stored as JSON string for SQLite
  isFavourite      Boolean   @default(false) @map("is_favourite")
  createdAt        DateTime  @default(now()) @map("created_at")
  // Feature #481: Document version tracking
  version          Int       @default(1)
  parentDocumentId String?   @map("parent_document_id")
  isLatestVersion  Boolean   @default(true) @map("is_latest_version")
  // Wave G G1 (spec §1.3(b), §1.7 E8). Deliberately NOT merged with
  // `isLatestVersion`: that answers "is this the newest upload of this file",
  // this answers "has this been formally replaced by an issued revision". Both
  // can be set on the same row and they are not derivable from one another.
  supersededById   String?   @map("superseded_by_id")
  // Client idempotency key (H5) — see NCR.requestKey. The offline photo queue
  // sends its stable local photo id so a retry after a dropped connection
  // returns the original Document instead of uploading the file twice.
  requestKey       String?   @map("request_key")

  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lot            Lot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)
  uploadedBy     User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  parentDocument Document?  @relation("DocumentVersions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  childVersions  Document[] @relation("DocumentVersions")
  supersededBy   Document?  @relation("DocumentSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Document[] @relation("DocumentSupersedes")

  itpCompletionAttachments ITPCompletionAttachment[]
  ncrEvidence              NCREvidence[]
  variationEvidence        VariationEvidence[]
  testCertificates         TestResult[]
  drawings                 Drawing[]
  signedUrlTokens          DocumentSignedUrlToken[]
  planSheets               PlanSheet[]
  importBatches            ImportBatch[]
  deliveryDockets          DiaryDelivery[]
  surveyReports            SurveyRecord[]

  @@unique([projectId, requestKey])
  @@index([projectId, documentType])
  @@index([projectId, lotId])
  @@index([projectId, uploadedAt])
  @@index([uploadedById, uploadedAt])
  @@index([parentDocumentId])
  @@index([projectId, supersededById])
  @@map("documents")
}

model DocumentSignedUrlToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @map("token_hash")
  documentId String   @map("document_id")
  userId     String   @map("user_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId, expiresAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("document_signed_url_tokens")
}

model Drawing {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  drawingNumber  String    @map("drawing_number")
  title          String?
  revision       String?
  issueDate      DateTime? @map("issue_date")
  status         String    @default("preliminary")
  documentId     String    @map("document_id")
  supersededById String?   @map("superseded_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  supersededBy Drawing?  @relation("DrawingSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Drawing[] @relation("DrawingSupersedes")

  @@unique([projectId, drawingNumber, revision])
  @@index([projectId, status])
  @@index([projectId, supersededById])
  @@index([documentId])
  @@map("drawings")
}

// ============================================================================
// Revision governance (Wave G, G1 — docs/plans/wave-g-execution-spec-2026-07-31.md §1)
// ============================================================================

// Issue-and-distribution record for one revision of one governed record.
//
// Keyed the way `Comment` is — `entityType` + `entityId`, no FK — because the
// five governed classes have genuinely different natural keys and a polymorphic
// `ControlledRecord` table would have to migrate and weaken `Drawing`'s shipped,
// indexed, uniquely-constrained revision chain (spec §1.3).
//
// `projectId` is REQUIRED and stays required (spec §1.3, [GR-B3]). The global
// ITP library has no project and nobody to issue to; it uses its own
// supersession chain (G2) and writes no row here. So an `entityType:
// 'itp_template'` row ALWAYS refers to a project-scoped template — AT-G36.
model RevisionIssue {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  // 'drawing' | 'specification' | 'itp_template' | 'approved_method' | 'client_direction'
  entityType    String   @map("entity_type")
  // The revision row's id — the NEW revision, never the superseded one.
  entityId      String   @map("entity_id")
  // Human rev token as issued ('C', 'Ed. 3', 'v4').
  revisionLabel String   @map("revision_label")
  // Prior revision's entityId; null for a first issue.
  supersedesId  String?  @map("supersedes_id")
  // Why replaced. REQUIRED whenever `supersedesId` is set (spec §1.7 E3).
  reason        String?
  issuedById    String   @map("issued_by_id")
  issuedAt      DateTime @default(now()) @map("issued_at")
  createdAt     DateTime @default(now()) @map("created_at")

  project    Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issuedBy   User                      @relation("RevisionIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  recipients RevisionAcknowledgement[]

  @@index([projectId, entityType, entityId])
  @@index([projectId, issuedAt])
  @@map("revision_issues")
}

// One recipient of one issue. `notifiedAt` != `openedAt` != `acknowledgedAt`:
// "we sent it", "they opened it" and "they said yes" are three different
// contractual facts, and the split follows the shipped `HoldPointReleaseToken`
// pattern rather than inventing one.
//
// The migration adds a hand-written CHECK — Prisma has no `@@check` ([GR-A10],
// AT-G37):
//   CHECK (NOT (user_id IS NOT NULL AND recipient_email IS NOT NULL))
//
// That is WEAKER than the spec's XOR, and deliberately: `onDelete: SetNull`
// below (E6) produces a (null, null) row on account deletion, which a true XOR
// rejects — turning every GDPR deletion into a 500. The "exactly one addressee"
// half is enforced at insert by `routes/revisions.ts`. Full reasoning in the
// migration.
model RevisionAcknowledgement {
  id             String    @id @default(uuid())
  issueId        String    @map("issue_id")
  userId         String?   @map("user_id")
  recipientEmail String?   @map("recipient_email")
  notifiedAt     DateTime? @map("notified_at")
  openedAt       DateTime? @map("opened_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  issue RevisionIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  // SetNull, never Cascade: deleting the fact that someone acknowledged would
  // be evidence destruction (spec §1.7 E6, AT-G6).
  user  User?         @relation("RevisionAcknowledgedBy", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([issueId, userId])
  @@unique([issueId, recipientEmail])
  @@index([issueId, acknowledgedAt])
  @@map("revision_acknowledgements")
}

// Which revision of which governed record a lot's work was performed under.
// Manual linking only (DG-3, decided): inference needs the spatial model and
// would produce confident wrong links.
//
// Rows are NEVER hard-deleted — unlinking sets `unlinkedAt`, because the history
// is the product. The migration adds the partial unique Prisma cannot express
// ([GR-A5], AT-G38):
//   CREATE UNIQUE INDEX lot_governing_revision_active_uniq
//     ON lot_governing_revisions (lot_id, entity_type, entity_id)
//     WHERE unlinked_at IS NULL;
model LotGoverningRevision {
  id            String    @id @default(uuid())
  lotId         String    @map("lot_id")
  // Denormalised from the lot. Makes E7 (cross-project link) a single
  // comparison at write time and lets every read scope by tenant without a
  // polymorphic resolution of `entityId` across five tables.
  projectId     String    @map("project_id")
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  // Denormalised and frozen at link time, so a folio can print what governed
  // the work without a live join surviving.
  revisionLabel String    @map("revision_label")
  linkedAt      DateTime  @default(now()) @map("linked_at")
  linkedById    String?   @map("linked_by_id")
  unlinkedAt    DateTime? @map("unlinked_at")

  lot      Lot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  // SetNull rather than Restrict: a link is an administrative act, not a
  // contractual assertion — unlike an acknowledgement, losing the actor
  // destroys no evidence.
  linkedBy User? @relation("GoverningRevisionLinkedBy", fields: [linkedById], references: [id], onDelete: SetNull)

  @@index([lotId, unlinkedAt])
  @@index([projectId, entityType, entityId])
  @@map("lot_governing_revisions")
}

/// Wave G G5 — the management learning loop's closing half
/// (`docs/plans/wave-g-execution-spec-2026-07-31.md` §5.3, boundary §0.3.5).
///
/// A recurring failure surfaced by the analytics is a fact; what to do about it
/// is a judgement. A reviewer writes the proposed change here, and ACCEPTING it
/// opens a NEW revision of the template — it never edits the template in place.
/// That is the whole point of sequencing G5 after G1/G2: the loop closes into
/// revision governance, so a lot conformed last month still says what it was
/// inspected against.
///
/// **No AI writes a proposal and nothing here auto-edits anything.** The row
/// records a human's words; the evidence columns are frozen counts of what the
/// data said at the moment they wrote them, so a proposal reviewed six weeks
/// later is judged against the trend that prompted it rather than a re-query.
model TemplateRevisionProposal {
  id         String @id @default(uuid())
  projectId  String @map("project_id")
  templateId String @map("template_id")
  // The checklist item the trend is about. Nullable: a proposal may be about a
  // template as a whole (an item that should EXIST has no id yet).
  checklistItemId String? @map("checklist_item_id")

  // Frozen evidence — what the trend said when the proposal was written.
  ncrCount           Int     @map("ncr_count")
  subcontractorCount Int     @map("subcontractor_count")
  // Lot activity the trend was observed on. Null is honest: `Lot.activitySlug`
  // is nullable when the activity fold resolved only to family level.
  activitySlug       String? @map("activity_slug")

  proposedChange String @map("proposed_change")
  // 'open' | 'accepted' | 'rejected'
  status         String @default("open")

  proposedById String?   @map("proposed_by_id")
  proposedAt   DateTime  @default(now()) @map("proposed_at")
  decidedById  String?   @map("decided_by_id")
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note")
  // The revision the acceptance created. Null while open, and null on reject.
  resultingTemplateId String? @map("resulting_template_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template          ITPTemplate       @relation("ProposalTemplate", fields: [templateId], references: [id], onDelete: Cascade)
  checklistItem     ITPChecklistItem? @relation("ProposalChecklistItem", fields: [checklistItemId], references: [id], onDelete: SetNull)
  resultingTemplate ITPTemplate?      @relation("ProposalResultingTemplate", fields: [resultingTemplateId], references: [id], onDelete: SetNull)
  // SetNull on both actors, matching `LotGoverningRevision.linkedBy`: a
  // proposal is an administrative act, and an account deletion must not delete
  // the decision. `proposedAt` / `decidedAt` survive intact.
  proposedBy User? @relation("TemplateRevisionProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  decidedBy  User? @relation("TemplateRevisionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, status, proposedAt])
  @@index([templateId])
  @@index([checklistItemId])
  @@index([resultingTemplateId])
  @@map("template_revision_proposals")
}

