// ============================================================================

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  /// Raw SQL CHECK constraint requires sha256:<64 lowercase hex>.
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ============================================================================
// Scheduled Reports
// ============================================================================

model ScheduledReport {
  id                String    @id @default(uuid())
  projectId         String    @map("project_id")
  reportType        String    @map("report_type") // lot-status, ncr, test, diary
  frequency         String // daily, weekly, monthly
  dayOfWeek         Int?      @map("day_of_week") // 0-6 for weekly reports (0=Sunday)
  dayOfMonth        Int?      @map("day_of_month") // 1-31 for monthly reports
  timeOfDay         String    @default("09:00") @map("time_of_day") // HH:mm format
  recipients        String // Comma-separated email addresses
  isActive          Boolean   @default(true) @map("is_active")
  lastSentAt        DateTime? @map("last_sent_at")
  nextRunAt         DateTime? @map("next_run_at")
  failureCount      Int       @default(0) @map("failure_count")
  lastFailureAt     DateTime? @map("last_failure_at")
  lastFailureReason String?   @map("last_failure_reason")
  createdById       String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project    Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?                              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs       ScheduledReportRun[]
  deliveries ScheduledReportRecipientDelivery[]

  @@index([isActive, nextRunAt, createdAt])
  @@index([projectId, createdAt])
  @@index([createdById, createdAt])
  @@map("scheduled_reports")
}

model ScheduledReportRun {
  id                 String    @id @default(uuid())
  scheduleId         String    @map("schedule_id")
  projectId          String    @map("project_id")
  reportType         String    @map("report_type")
  status             String    @default("processing")
  recipientCount     Int       @default(0) @map("recipient_count")
  sentCount          Int       @default(0) @map("sent_count")
  failedCount        Int       @default(0) @map("failed_count")
  digestCount        Int       @default(0) @map("digest_count")
  suppressedCount    Int       @default(0) @map("suppressed_count")
  errorReason        String?   @map("error_reason")
  generatedAt        DateTime  @map("generated_at")
  completedAt        DateTime? @map("completed_at")
  artifactFileUrl    String?   @map("artifact_file_url")
  artifactReportName String?   @map("artifact_report_name")
  artifactFilename   String?   @map("artifact_filename")
  artifactMimeType   String?   @map("artifact_mime_type")
  artifactFileSize   Int?      @map("artifact_file_size")
  artifactSha256     String?   @map("artifact_sha256")
  artifactCreatedAt  DateTime? @map("artifact_created_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  schedule   ScheduledReport                    @relation(fields: [scheduleId], references: [id], onDelete: Cascade, map: "scheduled_report_runs_schedule_id_fkey")
  project    Project                            @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "scheduled_report_runs_project_id_fkey")
  deliveries ScheduledReportRecipientDelivery[]

  @@index([scheduleId, createdAt], map: "scheduled_report_runs_schedule_created_idx")
  @@index([projectId, createdAt], map: "scheduled_report_runs_project_created_idx")
  @@index([status, createdAt], map: "scheduled_report_runs_status_created_idx")
  @@map("scheduled_report_runs")
}

model ScheduledReportRecipientDelivery {
  id            String    @id @default(uuid())
  runId         String    @map("run_id")
  scheduleId    String    @map("schedule_id")
  projectId     String    @map("project_id")
  recipient     String
  recipientKind String    @map("recipient_kind")
  status        String    @default("pending")
  retryable     Boolean   @default(false)
  attemptCount  Int       @default(0) @map("attempt_count")
  lockedUntil   DateTime? @map("locked_until")
  lastAttemptAt DateTime? @map("last_attempt_at")
  nextAttemptAt DateTime? @map("next_attempt_at")
  errorReason   String?   @map("error_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  run      ScheduledReportRun @relation(fields: [runId], references: [id], onDelete: Cascade, map: "scheduled_report_deliveries_run_id_fkey")
  schedule ScheduledReport    @relation(fields: [scheduleId], references: [id], onDelete: Cascade, map: "scheduled_report_deliveries_schedule_id_fkey")
  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "scheduled_report_deliveries_project_id_fkey")

  @@unique([runId, recipient], map: "scheduled_report_delivery_run_recipient_key")
  @@index([scheduleId, status, nextAttemptAt], map: "scheduled_report_delivery_schedule_status_next_idx")
  @@index([scheduleId, recipient, retryable], map: "scheduled_report_delivery_schedule_recipient_retry_idx")
  @@index([projectId, createdAt], map: "scheduled_report_delivery_project_created_idx")
  @@map("scheduled_report_recipient_deliveries")
}

// ============================================================================
// Comments
// ============================================================================

model Comment {
  id         String    @id @default(uuid())
  entityType String    @map("entity_type") // Lot, NCR, TestResult, etc.
  entityId   String    @map("entity_id")
  parentId   String?   @map("parent_id") // For reply threading
  content    String
  authorId   String?   @map("author_id")
  isEdited   Boolean   @default(false) @map("is_edited")
  editedAt   DateTime? @map("edited_at")
  deletedAt  DateTime? @map("deleted_at") // Soft delete
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent      Comment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Comment[]           @relation("CommentReplies")
  attachments CommentAttachment[]

  @@index([entityType, entityId])
  @@index([authorId, createdAt], map: "comments_author_created_at_idx")
  @@map("comments")
}

model CommentAttachment {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  filename  String
  fileUrl   String   @map("file_url")
  fileSize  Int?     @map("file_size")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_attachments")
}

// Immutable audit log of AI-assisted proposals: user request -> AI candidate ->
// sources -> human decision (accept/edit/reject, by whom, when) -> applied
// records. The `payload` is the AI's original proposal and is NEVER updated;
// human edits are stored separately in `editedPayload`. This trail is what keeps
// an AI-assisted QA pack insurable (Verisk 2026 PI exclusions for un-audited AI).
model AiProposal {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  stage            String // 'project_facts' | 'control_line' | 'plan_sheets' | 'lot_breakdown' (open set)
  status           String    @default("proposed") // proposed|accepted|edited|rejected|superseded|rolled_back
  requestedById    String    @map("requested_by_id")
  model            String // anthropic model id used for the extraction
  sourceRefs       Json      @map("source_refs") // citations: [{documentId?, fileName?, page?, note?}]
  payload          Json // the proposed candidate — IMMUTABLE, never updated
  warnings         Json?
  decidedById      String?   @map("decided_by_id")
  decidedAt        DateTime? @map("decided_at")
  editedPayload    Json?     @map("edited_payload") // what was actually applied when action=accept-with-edits
  appliedRecordIds Json?     @map("applied_record_ids") // [{model, ids}] created on apply — rollback target
  createdAt        DateTime  @default(now()) @map("created_at")
  // Wave B: ONE import batch produces exactly ONE proposal. @unique makes that a
  // database invariant rather than a convention. Nullable, so every pre-Wave-B
  // stage is unaffected (Postgres permits many nulls in a unique index).
  importBatchId    String?   @unique @map("import_batch_id")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([projectId, stage])
  @@index([projectId, status])
  @@map("ai_proposals")
}

// ============================================================================
// Wave B — migration importer
// ============================================================================

// The envelope over one migration run. Owns the source file, the chosen mapping
// profile, the dry-run result and the per-row outcome ledger. It does NOT apply
// records itself — it spawns ONE AiProposal that does.
model ImportBatch {
  id     String @id @default(uuid())
  // 'itp_template' | 'lot_register' (open set; 'test_register' is RESERVED and
  // deliberately unimplemented until the Wave C sample/test model is final).
  kind   String
  // uploaded|parsed|mapped|dry_run|review|applied|rolled_back|cancelled|failed
  status String @default("uploaded")

  projectId    String @map("project_id")
  sourceFormat String @map("source_format") // 'excel' | 'pdf' | 'word'

  // Why status='failed' — operator- and user-readable, never a stack trace.
  failedReason     String? @map("failed_reason")
  // NULLABLE + SetNull, deliberately NOT Restrict. Document.project is
  // onDelete: Cascade, so a Restrict child hanging off a cascade parent would
  // abort project deletion outright. Source survival is enforced in the
  // APPLICATION layer instead, where it can produce a real error message.
  sourceDocumentId String? @map("source_document_id")
  mappingProfileId String? @map("mapping_profile_id")

  parseResult Json? @map("parse_result") // normalized grid {sheets:[{name, headers, rows}]}, byte-capped
  dryRun      Json? @map("dry_run") // counts + per-row outcome + reasons

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument Document?             @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  mappingProfile ImportMappingProfile? @relation(fields: [mappingProfileId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  proposal       AiProposal?
  itpTemplates   ITPTemplate[]

  @@index([projectId, kind, status])
  @@index([projectId, createdAt])
  @@index([status, updatedAt]) // drives the abandoned-batch GC sweep
  @@map("import_batches")
}

// A reusable, tenant-owned column/field mapping. Built-ins (CivilPro, generic
// AU ITP) are global rows: a mapping is column-name metadata and carries no ITP
// prose, so sharing one is not a leak of tenant specification text.
model ImportMappingProfile {
  id           String  @id @default(uuid())
  projectId    String? @map("project_id") // null = built-in
  companyId    String? @map("company_id") // company-wide reuse; null for built-ins
  name         String
  kind         String
  sourceFormat String  @map("source_format")
  // Ordered field map: target field <- source column header + transform.
  // TENANT-WRITABLE JSON. Every `target` and `transform` is re-validated against
  // a fixed server-side allow-list at APPLY time, not only at save time.
  fieldMap     Json    @map("field_map")

  version   Int      @default(1)
  isBuiltIn Boolean  @default(false) @map("is_built_in")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches ImportBatch[]

  @@index([companyId, kind])
  @@index([projectId, kind])
  @@map("import_mapping_profiles")
}

// ============================================================================
// Wave D `D1b` — the issued folio
// (spec `docs/plans/wave-d-handover-spec-2026-07-28.md` Rev 3, §7.1–§7.3, §7.7,
// §4.4.2; threat model `docs/plans/wave-d1b-threat-model-2026-07-28.md`.)
//
// Three tables, one issuance sequence, two UPDATE-rejecting triggers and one
// CHECK. Read §4.4.2 before changing any of it — the ORDER is the invariant:
// snapshot + reservation commit first, the bytes are written outside any
// transaction, and the `FolioIssue` row lands only once those bytes are
// durable (**AT-146**). A row here means a readable folio exists.
// ============================================================================

/// The immutable source snapshot (`[DR-B3]`, spec §7.3). Everything the folio
/// renders comes from `payload`; the renderer never re-reads the database, so
/// the folio is a true statement about ONE moment (threat model T-2).
model FolioSnapshot {
  id                   String   @id @default(uuid())
  projectId            String   @map("project_id")
  lotId                String   @map("lot_id")
  /// The whole server-assembled payload: lot, project, frozen branding (§2.5),
  /// evidence rows and the RESOLVED §2.3 profile verdicts. JSON, because it is
  /// a frozen document and never a query surface.
  payload              Json
  /// Bumped whenever `payload`'s shape OR a §7.7 digest field list changes — a
  /// digest whose input set moves silently is worse than no digest.
  payloadSchemaVersion Int      @map("payload_schema_version")
  /// `LOGAN_PSP5_PROFILE_VERSION` at assembly time (§2.3).
  profileVersion       String   @map("profile_version")
  /// §7.7 revision tokens for every source row the payload compiled from.
  sourceRowRefs        Json     @map("source_row_refs")
  createdById          String?  @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  /// A snapshot with no folio issued against it before this is stale, and
  /// rendering from it is refused (threat model T-2). The SWEEP itself is
  /// `D1c`; expiry is enforced on read here.
  expiresAt            DateTime @map("expires_at")

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lot          Lot                     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdBy    User?                   @relation("FolioSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reservations FolioIssueReservation[]
  issues       FolioIssue[]

  @@index([lotId, createdAt])
  @@index([expiresAt])
  @@map("folio_snapshots")
}

/// The durable version binding (`[DR2-B3]`, spec §7.2). Rev 2 asserted this in
/// prose and persisted it nowhere; two concurrent sessions cannot share a
/// version because the SECOND INSERT FAILS on `[lot_id, version]`.
///
/// Rows are never deleted by `D1b`: the next version is `MAX(version) + 1` over
/// THIS table, so an unissued or expired reservation retires its version rather
/// than recycling it (§10.5, "a gap in a version sequence is harmless, reuse is
/// not"). A reservation is RETIRED when a `FolioIssue` points at it.
model FolioIssueReservation {
  /// The preallocated `FolioIssue` id, per §7.2 — the id is reserved, not
  /// minted later, so the storage object path is known before the bytes exist.
  issueId      String   @id @map("issue_id")
  projectId    String   @map("project_id")
  lotId        String   @map("lot_id")
  snapshotId   String   @map("snapshot_id")
  version      Int
  reservedById String?  @map("reserved_by")
  reservedAt   DateTime @default(now()) @map("reserved_at")
  expiresAt    DateTime @map("expires_at")

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lot        Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  snapshot   FolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  reservedBy User?         @relation("FolioReservedBy", fields: [reservedById], references: [id], onDelete: SetNull)
  issue      FolioIssue?

  @@unique([lotId, version])
  @@index([expiresAt])
  @@map("folio_issue_reservations")
}

/// The issued folio (spec §7.1). Append-only: a database TRIGGER rejects
/// `UPDATE`, because the absence of an `updatedAt` column prevents nothing
/// (`[DR-B7]`, **AT-141**). `format` is CHECK-constrained to `'folio'` so a
/// route bypass cannot persist an authority-certificate format on an artefact
/// that carries no certification (`[DR2-B5]`, **AT-147**).
model FolioIssue {
  id               String    @id
  projectId        String    @map("project_id")
  lotId            String    @map("lot_id")
  snapshotId       String    @map("snapshot_id")
  reservationId    String    @unique @map("reservation_id")
  version          Int
  /// Always `'folio'`. A column rather than a constant so a second
  /// server-rendered document is additive; a CHECK rather than a vocabulary so
  /// nothing else can be written today.
  format           String    @default("folio")
  /// `supabase://documents/...` reference, or the local dev path. Never a
  /// browser-facing URL — downloads go through the authenticated route.
  fileUrl          String    @map("file_url")
  fileSize         BigInt    @map("file_size")
  /// SHA-256 over the bytes THE SERVER PRODUCED. Never client-supplied
  /// (**AT-124**).
  sha256           String
  issuedById       String?   @map("issued_by")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  /// Schema-versioned source identity: every entry carries a §7.7 revision
  /// token of the kind declared for its source type.
  compiledFrom     Json      @map("compiled_from")
  lotStatusAtIssue String    @map("lot_status_at_issue")
  conformedAtIssue DateTime? @map("conformed_at_issue")

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lot         Lot                   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  snapshot    FolioSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  reservation FolioIssueReservation @relation(fields: [reservationId], references: [issueId], onDelete: Cascade)
  issuedBy    User?                 @relation("FolioIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  // The unique constraint already indexes `[lotId, version]`; Rev 1's extra
  // identical index is deliberately absent (`[DR-B7]`).
  @@unique([lotId, version])
  @@index([projectId, issuedAt])
  @@map("folio_issues")
}

// ============================================================================
// Wave D `D1c.1` — the handover export job row, the frozen member ledger and
// legal hold
// (spec `docs/plans/wave-d-handover-spec-2026-07-28.md` Rev 3 §7.4–§7.6, §4.6.)
//
// Three tables, NO trigger and NO CHECK. That asymmetry with the folio tables
// above is deliberate and is the whole difference between the two halves of
// Wave D: a `FolioIssue` is a historical record, so `UPDATE` is rejected in the
// database; a `HandoverExport` is a MUTABLE JOB ROW that a worker claims,
// heartbeats, publishes and expires. Its correctness comes from the fencing
// token (§4.6.2), not from immutability.
// ============================================================================

/// One archive generation request (§7.4). `D1c.1` creates it and freezes its
/// ledger; `D1c.2` runs it.
///
/// The lease quartet — `leaseOwner`, `leaseToken`, `leaseExpiresAt`,
/// `heartbeatAt` — is what an OUT-OF-PROCESS worker (`[DH-j]`) needs to claim,
/// fence and renew a job it never received as a request. Every state write is
/// conditional on `leaseToken` (`lib/handover/exportLease.ts`); the token also
/// keys the storage object, so two workers physically cannot collide and the
/// loser's object is simply unreachable (§4.6.2, **AT-135**).
model HandoverExport {
  id                String    @id @default(uuid())
  projectId         String    @map("project_id")
  /// `{kind:'project'|'area'|'lots', areaId?, lotIds?}` — §4.7.6 promotes this
  /// from a convenience to the mechanism by which a project too large for the
  /// 8 GiB cap is delivered at all.
  scope             Json
  /// `queued|snapshotting|processing|complete|failed|cancelled`. Zod-validated
  /// at the route; no Prisma enum anywhere in this schema.
  status            String    @default("queued")
  requestedById     String?   @map("requested_by")
  requestedAt       DateTime  @default(now()) @map("requested_at")
  leaseOwner        String?   @map("lease_owner")
  /// The FENCING token. Regenerated on every claim, so a worker resumed from a
  /// stale lease holds a token no state write will match.
  leaseToken        String?   @map("lease_token")
  leaseExpiresAt    DateTime? @map("lease_expires_at")
  heartbeatAt       DateTime? @map("heartbeat_at")
  nextAttemptAt     DateTime? @map("next_attempt_at")
  failureCount      Int       @default(0) @map("failure_count")
  lastFailureReason String?   @map("last_failure_reason")
  /// When the member ledger was frozen. Everything after it is out of this
  /// archive by design, and the manifest says so (§4.6.1).
  snapshotCutoffAt  DateTime? @map("snapshot_cutoff_at")
  totalMembers      Int?      @map("total_members")
  processedMembers  Int       @default(0) @map("processed_members")
  /// BigInt, not Int: `fileSize Int` caps at 2,147,483,647 bytes and the cap is
  /// 8 GiB (§4.5.5).
  totalBytes        BigInt?   @map("total_bytes")
  fileSize          BigInt?   @map("file_size")
  fileUrl           String?   @map("file_url")
  sha256            String?
  /// S3 multipart state — upload id, part numbers, ETags (§4.5.3, §4.6.3). A
  /// TRANSPORT-layer resume; the ZIP itself is always rebuilt from the ledger.
  uploadState       Json?     @map("upload_state")
  manifestSummary   Json?     @map("manifest_summary")
  completedAt       DateTime? @map("completed_at")
  /// The retention TTL (§10.5). When the artefact is swept the ROW SURVIVES
  /// with a null `fileUrl` — an export that was generated and has expired is a
  /// fact worth keeping (**AT-148**).
  expiresAt         DateTime? @map("expires_at")

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User?                  @relation("HandoverExportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  members     HandoverExportMember[]

  @@index([projectId, requestedAt])
  @@index([status, leaseExpiresAt])
  @@index([expiresAt])
  @@map("handover_exports")
}

/// The FROZEN member ledger (§7.5, `[DR-B7]`). Rev 1's archive claimed to be
/// "reproducible from immutable inputs" while selecting mutable, supersedable
/// documents. A row here pins one source row AS IT WAS at the freeze: if a
/// folio is reissued mid-archive, the archive continues from this row and
/// records the cutoff. It never switches versions halfway through.
model HandoverExportMember {
  id             String  @id @default(uuid())
  exportId       String  @map("export_id")
  /// `folio|document|holdpoint_signature|holdpoint_evidence|itp_attachment|ncr_evidence`
  sourceType     String  @map("source_type")
  sourceId       String  @map("source_id")
  /// The §7.7 revision token, stringified — `v:{n}` / `t:{iso}` / `d:{sha256}`.
  /// Renamed from Rev 2's `sourceVersion Int?`, which assumed every source
  /// model has an integer version and `[DR2-B3]` showed several do not.
  sourceRevision String? @map("source_revision")
  storageLocator String  @map("storage_locator")
  archivePath    String  @map("archive_path")
  /// NULLABLE — §4.5.4's unmeasured set. `HoldPoint.releaseSignatureUrl` and
  /// `evidencePackageUrl` are bare strings with no stored size, so a preflight
  /// is an ESTIMATE with a named unmeasured set, not a measurement.
  byteSize       BigInt? @map("byte_size")
  sourceChecksum String? @map("source_checksum")
  /// `pending|verified|written|omitted`
  state          String  @default("pending")
  omissionReason String? @map("omission_reason")
  /// The deterministic sort key (§4.7.3): lot, then category, then uploadedAt,
  /// then id. Frozen with the row so two runs cannot order differently.
  orderKey       String  @map("order_key")

  export HandoverExport @relation(fields: [exportId], references: [id], onDelete: Cascade)

  @@unique([exportId, archivePath])
  @@index([exportId, state])
  @@map("handover_export_members")
}

/// Legal hold, APPEND-ONLY (§7.6, `[DR2-B5]`). The naive fix — an
/// `onLegalHold` boolean on `FolioIssue` — is self-contradictory: it is an
/// `UPDATE` on a table whose trigger rejects `UPDATE`.
///
/// An artefact is on hold when its MOST RECENT ROW is `placed`. No update, no
/// delete, no boolean — a hold and its release are both events, and the
/// sequence is the only shape that survives being asked "who put this on hold,
/// when, and why" two years later. **AT-148**.
model ArtifactLegalHold {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  /// `folio_issue|handover_export`. Deliberately NOT a foreign key: one hold
  /// table over two artefact tables, and a hold outliving a cascade is the
  /// safer failure than a hold that vanishes with its target.
  artifactType String   @map("artifact_type")
  artifactId   String   @map("artifact_id")
  /// `placed|released`
  action       String
  reason       String
  actorId      String?  @map("actor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ArtifactLegalHoldActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([artifactType, artifactId, createdAt])
  @@map("artifact_legal_holds")
}

// ============================================================================
// Survey records (Wave C5.2)
// ============================================================================

/// A survey deliverable as FILED EVIDENCE: which survey, on which lot, done by
/// whom, the report file, and **the verdict the surveyor themselves stated**.
///
/// `[C5S-B1]` — the rule this table turns on: **a conformance verdict is a
/// certification. CIVOS records who made one; it never makes one.** There is no
/// coordinate, no level, no deviation and no tolerance column here, and there
/// will not be one until RG-2 and RG-3 are discharged against primary sources.
/// `surveyorVerdict` is a TRANSCRIPTION of what the report says, with
/// `'not_stated'` as a first-class value so "the report gave no verdict" is a
/// recordable fact rather than a backfilled guess.
///
/// Supersession is RECORD-level, in the `Drawing` shape: a re-survey is a new
/// professional act, so it is a new row with `supersededById` set on the old
/// one — never a new version of the old row's `Document`. The report FK is
/// `Restrict` so the original file cannot be deleted out from under it.
model SurveyRecord {
  id        String  @id @default(uuid())
  /// Derived from the lot at write time, never read from the request body.
  projectId String  @map("project_id")
  lotId     String? @map("lot_id")
  /// `set_out|conformance|as_built`, CHECK-constrained. Three, because they are
  /// three different contractual acts. No fourth is added speculatively.
  kind      String
  /// `requested|in_progress|received|accepted|rejected`, CHECK-constrained.
  /// PILOT-GATED `[C5S-B4]`: the names encode a claim about how a real job runs
  /// and stay behind C5_SURVEY_RECORDS_ENABLED until one real conformance
  /// survey has round-tripped. The CHECK is what makes correcting them a
  /// reviewed migration instead of a silent data drift.
  status    String  @default("requested")

  requestedById String?   @map("requested_by")
  requestedAt   DateTime? @map("requested_at")

  /// The surveyor is a real, identifiable third-party professional. Every one of
  /// these is transcribed by a named CIVOS user and every write is audited —
  /// a wrong entry here is a defamation-shaped risk, not just a data one.
  surveyorName         String?   @map("surveyor_name")
  surveyorCompany      String?   @map("surveyor_company")
  surveyorRegistration String?   @map("surveyor_registration")
  surveyedAt           DateTime? @map("surveyed_at")

  reportDocumentId String? @map("report_document_id")

  /// `conforms|does_not_conform|qualified|not_stated`, CHECK-constrained.
  /// THE SURVEYOR'S, not CIVOS's. Every surface renders it attributed.
  surveyorVerdict  String? @map("surveyor_verdict")
  /// Where in the report the verdict was read from, so a reader can check it.
  verdictSourceNote String? @map("verdict_source_note")

  reviewedById String?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  acceptedById String?   @map("accepted_by")
  acceptedAt   DateTime? @map("accepted_at")

  rejectionReason String? @map("rejection_reason")
  supersededById  String? @map("superseded_by_id")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lot            Lot?           @relation(fields: [lotId], references: [id], onDelete: SetNull)
  reportDocument Document?      @relation(fields: [reportDocumentId], references: [id], onDelete: Restrict)
  requestedBy    User?          @relation("SurveyRequestedByUser", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy     User?          @relation("SurveyReviewedByUser", fields: [reviewedById], references: [id], onDelete: SetNull)
  acceptedBy     User?          @relation("SurveyAcceptedByUser", fields: [acceptedById], references: [id], onDelete: SetNull)
  supersededBy   SurveyRecord?  @relation("SurveyRecordSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     SurveyRecord[] @relation("SurveyRecordSupersedes")

  @@index([projectId, status])
  @@index([lotId])
  @@index([projectId, kind])
  @@map("survey_records")
}
