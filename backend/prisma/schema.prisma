model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  type      String
  title     String
  message   String?
  linkUrl   String?  @map("link_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  projectId  String?  @map("project_id")
  userId     String?  @map("user_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  changes    String? // Stored as JSON string for SQLite
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  requirementEvaluations RequirementEvaluation[]

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// F0.4a decision snapshot (execution spec §3). Readiness stays COMPUTED at
/// request time; a row is persisted here only at a decision point, so the
/// evidence pack can answer "what did the system know when this was decided?"
///
/// `entityType` is one of 'lot' | 'hold_point' | 'ncr' | 'claim' | 'claim_lot' |
/// 'claim_variation'. claim_lot rows key `entityId` on ClaimedLot.id (NOT the
/// lot id); claim_variation rows key on Variation.id — there is no
/// claim-variation join row (variations link via Variation.claimedInId).
///
/// Rows are immutable: no update/delete API. Project deletion cascades; the
/// `Restrict` FK to AuditLog means an audit row referenced by a snapshot can
/// never be deleted — audit + snapshot are one retention unit.
///
/// Written only by `backend/src/lib/readiness/recordDecision.ts`, inside the
/// decision transaction, behind `READINESS_SNAPSHOTS_ENABLED`.
model RequirementEvaluation {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  entityType          String   @map("entity_type")
  entityId            String   @map("entity_id")
  decisionKind        String   @map("decision_kind")
  // The EXISTING AuditAction recorded alongside — no new audit vocabulary.
  auditAction         String   @map("audit_action")
  requirementSet      String   @map("requirement_set")
  // Bump when the `result` JSON shape changes; readers dispatch on this column.
  resultSchemaVersion Int      @map("result_schema_version")
  result              Json
  // Client idempotency key when provided; replay returns the original row.
  requestKey          String?  @map("request_key")
  actorKind           String   @map("actor_kind")
  actorUserId         String?  @map("actor_user_id")
  actorTokenId        String?  @map("actor_token_id")
  actorLabel          String?  @map("actor_label")
  evaluatedAt         DateTime @default(now()) @map("evaluated_at")
  // REQUIRED — a snapshot always belongs to a decision's audit row.
  auditLogId          String   @map("audit_log_id")

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditLog   AuditLog               @relation(fields: [auditLogId], references: [id], onDelete: Restrict)
  actorUser  User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorToken HoldPointReleaseToken? @relation(fields: [actorTokenId], references: [id], onDelete: SetNull)

  // One snapshot per entity per decision — permits a claim decision's aggregate
  // + per-member rows under one audit row while barring duplicates.
  @@unique([auditLogId, entityType, entityId])
  // Request-key replay returns the original, never a duplicate.
  @@unique([entityType, entityId, requestKey])
  @@index([entityType, entityId, evaluatedAt])
  @@index([projectId, decisionKind])
  @@map("requirement_evaluations")
}

/// Privacy-conscious UX/product telemetry. Deliberately SEPARATE from AuditLog:
/// AuditLog is a compliance artifact in a QA-evidence product and must stay pure,
/// so funnel/UX events live here with independent (short) retention.
///
/// Privacy posture — what is NOT collected, by construction:
///   - NO IP address, NO user agent (unlike AuditLog, which keeps both).
///   - NO free-text: `metadata` holds only server-whitelisted, structured keys
///     validated per-event (see lib/productEvents.ts). No page URLs / query
///     strings, no message bodies, no names.
///   - `event` names are rejected unless present in the registered catalog, so
///     the table cannot fill with arbitrary strings.
/// userId/companyId are derived server-side from the authenticated user, never
/// from the client body.
model ProductEvent {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  projectId String?   @map("project_id")
  companyId String?   @map("company_id")
  event     String // dot-namespaced, catalog-registered, e.g. 'lot_create.opened'
  step      String?
  metadata  Json? // structured, whitelisted keys only — never free text
  clientTs  DateTime? @map("client_ts")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([event, createdAt])
  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("product_events")
}

model SyncQueue {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  deviceId           String?   @map("device_id")
  entityType         String    @map("entity_type")
  entityId           String?   @map("entity_id")
  action             String
  payload            String // Stored as JSON string for SQLite
  status             String    @default("pending")
  createdAt          DateTime  @default(now()) @map("created_at")
  syncedAt           DateTime? @map("synced_at")
  conflictResolution String?   @map("conflict_resolution")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sync_queue")
}

