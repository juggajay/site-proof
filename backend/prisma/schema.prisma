model DiaryDelay {
  id            String   @id @default(uuid())
  diaryId       String   @map("diary_id")
  delayType     String   @map("delay_type")
  startTime     String?  @map("start_time")
  endTime       String?  @map("end_time")
  durationHours Decimal? @map("duration_hours")
  description   String
  impact        String?
  lotId         String?  @map("lot_id")
  createdAt     DateTime @default(now()) @map("created_at")

  diary DailyDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  lot   Lot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@map("diary_delays")
}

model DiaryDelivery {
  id           String   @id @default(uuid())
  diaryId      String   @map("diary_id")
  description  String
  supplier     String?
  docketNumber String?  @map("docket_number")
  quantity     Decimal?
  unit         String?
  lotId        String?  @map("lot_id")
  notes        String?
  // C5.1 evidence fields (spec §4.4). Written ONLY by
  // `PATCH /api/deliveries/:deliveryId/evidence`, which deliberately does not
  // take the diary-editable lock: the supplier's docket arrives the morning
  // after the diary was submitted (§4.4a). The foreman's account of the day —
  // description/quantity/unit/supplier/notes — stays locked with the diary.
  docketDocumentId String? @map("docket_document_id")
  // Transcribed from the docket. Free text, never parsed and never validated
  // against a vocabulary — structuring it is C5.4, behind RG-6.
  batchRef         String? @map("batch_ref")
  // Client idempotency key (H5) — see NCR.requestKey.
  requestKey   String?  @map("request_key")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  diary DailyDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  lot   Lot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)
  // Restrict, not SetNull like TestResult.certificateDoc: a delivery whose
  // docket silently detached is worse evidence than a document that refuses to
  // delete. Follows Drawing.document. The usable error message comes from the
  // `delivery_docket` EVIDENCE_LINK_GUARDS entry, not from this FK.
  docketDocument Document? @relation(fields: [docketDocumentId], references: [id], onDelete: Restrict)
  // C5.4a. Back-relation only; the FK and its index live on `ncrs`.
  linkedNcrs     NCR[]     @relation("NcrLinkedDelivery")

  @@unique([diaryId, requestKey])
  @@index([lotId])
  @@map("diary_deliveries")
}

model DiaryEvent {
  id          String   @id @default(uuid())
  diaryId     String   @map("diary_id")
  eventType   String   @map("event_type")
  description String
  notes       String?
  lotId       String?  @map("lot_id")
  // Provenance: 'manual' (typed by a user) or 'qa' (auto-compiled from the day's
  // QA activity). sourceRef is the stable identity of the source record for that
  // auto row (e.g. "ncr_raised:<id>", "itp:<lotId>"), used for idempotent upsert
  // and reconciliation. Manual rows leave sourceRef null. Copy-forward / any diary
  // machinery must exclude source != 'manual' rows (H11).
  source      String   @default("manual")
  sourceRef   String?  @map("source_ref")
  // Client idempotency key (H5) — see NCR.requestKey. Distinct from sourceRef:
  // sourceRef is the provenance of an auto-compiled QA row, this is a manual
  // row's replay key.
  requestKey  String?  @map("request_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  diary DailyDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  lot   Lot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@unique([diaryId, sourceRef])
  @@unique([diaryId, requestKey])
  @@map("diary_events")
}

model DiaryAddendum {
  id        String   @id @default(uuid())
  diaryId   String   @map("diary_id")
  content   String
  addedById String?  @map("added_by")
  addedAt   DateTime @default(now()) @map("added_at")

  diary   DailyDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  addedBy User?      @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@map("diary_addendums")
}

