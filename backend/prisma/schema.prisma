// SiteProof v3 - Prisma Schema
// Civil Execution and Conformance Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Core Entities
// ============================================================================

model Company {
  id               String   @id @default(uuid())
  name             String
  abn              String?
  address          String?
  logoUrl          String?  @map("logo_url")
  subscriptionTier String   @default("basic") @map("subscription_tier")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Wave F / F2 — Xero sales-invoice CSV export config, company-scoped so two
  // people exporting the same claim from different browsers cannot produce
  // different account codes (the localStorage version could). Columns, not a
  // table: two scalars with no independent lifecycle, no history requirement
  // and one row per company either way. Null = use the export's own defaults
  // (`200` / `GST on Income`), so behaviour is unchanged for anyone who never
  // set one. See docs/plans/wave-f-claim-readiness-spec-2026-07-31.md §2.2.
  xeroAccountCode String? @map("xero_account_code")
  xeroTaxType     String? @map("xero_tax_type")

  users                 User[]
  projects              Project[]
  globalSubcontractors  GlobalSubcontractor[]
  webhookConfigs        WebhookConfig[]
  importMappingProfiles ImportMappingProfile[]

  @@map("companies")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String?   @map("password_hash")
  fullName              String?   @map("full_name")
  phone                 String?
  avatarUrl             String?   @map("avatar_url")
  companyId             String?   @map("company_id")
  roleInCompany         String    @default("member") @map("role_in_company")
  emailVerified         Boolean   @default(false) @map("email_verified")
  emailVerifiedAt       DateTime? @map("email_verified_at")
  tosAcceptedAt         DateTime? @map("tos_accepted_at")
  tosVersion            String?   @map("tos_version")
  // MFA fields (Feature #22, #420, #421)
  twoFactorEnabled      Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret       String?   @map("two_factor_secret")
  // OAuth fields (Feature #414, #1004)
  oauthProvider         String?   @map("oauth_provider")
  oauthProviderId       String?   @map("oauth_provider_id")
  // Token invalidation for logout-all-devices feature
  tokenInvalidatedAt    DateTime? @map("token_invalidated_at")
  // Account-level product-tour completion. Durable across devices and storage
  // clears so an existing user is never re-shown the first-run onboarding tour
  // (the per-device localStorage marker is only a cache on top of this).
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  company                     Company?                     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projectUsers                ProjectUser[]
  createdLots                 Lot[]                        @relation("CreatedByUser")
  createdControlLines         ControlLine[]                @relation("CreatedControlLines")
  createdPlanSheets           PlanSheet[]                  @relation("CreatedPlanSheets")
  conformedLots               Lot[]                        @relation("ConformedByUser")
  conformanceOverriddenLots   Lot[]                        @relation("ConformanceOverriddenByUser")
  raisedNCRs                  NCR[]                        @relation("RaisedByUser")
  responsibleNCRs             NCR[]                        @relation("ResponsibleUser")
  verifiedNCRs                NCR[]                        @relation("VerifiedByUser")
  closedNCRs                  NCR[]                        @relation("ClosedByUser")
  qmApprovedNCRs              NCR[]                        @relation("QMApprovedByUser")
  respondedNCRs               NCR[]                        @relation("RespondedByUser")
  qmReviewedNCRs              NCR[]                        @relation("QMReviewedByUser")
  escalatedNCRs               NCR[]                        @relation("EscalatedByUser")
  submittedDiaries            DailyDiary[]
  diaryAddendums              DiaryAddendum[]
  itpCompletions              ITPCompletion[]              @relation("CompletedByUser")
  itpVerifications            ITPCompletion[]              @relation("VerifiedByUser")
  testEntries                 TestResult[]                 @relation("EnteredByUser")
  testVerifications           TestResult[]                 @relation("VerifiedByTestUser")
  testRejections              TestResult[]                 @relation("RejectedByTestUser")
  surveyRequests              SurveyRecord[]               @relation("SurveyRequestedByUser")
  surveyReviews               SurveyRecord[]               @relation("SurveyReviewedByUser")
  surveyAcceptances           SurveyRecord[]               @relation("SurveyAcceptedByUser")
  uploadedDocs                Document[]
  documentSignedUrlTokens     DocumentSignedUrlToken[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  productEvents               ProductEvent[]
  syncQueues                  SyncQueue[]
  preparedClaims              ProgressClaim[]
  createdVariations           Variation[]                  @relation("CreatedVariations")
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  comments                    Comment[]
  apiKeys                     ApiKey[] // Feature #747: External API access
  consentRecords              ConsentRecord[] // Feature #776: Privacy consent tracking
  assignedLotSubcontractors   LotSubcontractorAssignment[] @relation("AssignedByUser")
  subcontractorUsers          SubcontractorUser[]
  scheduledReports            ScheduledReport[]
  mfaBackupCodes              MfaBackupCode[]
  createdWebhooks             WebhookConfig[]              @relation("CreatedWebhookConfigs")
  pushSubscriptions           PushSubscription[]
  oauthCallbackCodes          OauthCallbackCode[]
  notificationEmailPreference NotificationEmailPreference?
  notificationDigestItems     NotificationDigestItem[]
  assignedNotificationAlerts  NotificationAlert[]          @relation("AssignedNotificationAlerts")
  revokedAuthTokens           RevokedAuthToken[]
  requirementEvaluations      RequirementEvaluation[]
  importBatches               ImportBatch[]
  folioSnapshots              FolioSnapshot[]              @relation("FolioSnapshotCreatedBy")
  folioIssueReservations      FolioIssueReservation[]      @relation("FolioReservedBy")
  folioIssues                 FolioIssue[]                 @relation("FolioIssuedBy")
  handoverExports             HandoverExport[]             @relation("HandoverExportRequestedBy")
  artifactLegalHolds          ArtifactLegalHold[]          @relation("ArtifactLegalHoldActor")
  revisionIssues              RevisionIssue[]              @relation("RevisionIssuedBy")
  revisionAcknowledgements    RevisionAcknowledgement[]    @relation("RevisionAcknowledgedBy")
  governingRevisionLinks      LotGoverningRevision[]       @relation("GoverningRevisionLinkedBy")
  templateRevisionsProposed   TemplateRevisionProposal[]   @relation("TemplateRevisionProposedBy")
  templateRevisionsDecided    TemplateRevisionProposal[]   @relation("TemplateRevisionDecidedBy")

  @@index([companyId])
  @@map("users")
}

model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_backup_codes")
}

// Feature #747: API Keys for external REST access
model ApiKey {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String // Descriptive name for the key
  keyHash    String    @unique @map("key_hash") // Hashed API key (never store plain)
  keyPrefix  String    @map("key_prefix") // First 8 chars for identification
  scopes     String    @default("read") // Comma-separated: read,write,admin
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("api_keys")
}

model RevokedAuthToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime @default(now()) @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("revoked_auth_tokens")
}

// Feature #776: Privacy Consent Tracking
model ConsentRecord {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  consentType String   @map("consent_type") // marketing, analytics, data_processing, terms_of_service
  version     String // Version of the consent/policy
  granted     Boolean // true = granted, false = withdrawn
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@map("consent_records")
}

model WebhookConfig {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  url         String
  secret      String
  events      String   @default("[\"*\"]")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("CreatedWebhookConfigs", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([companyId, enabled])
  @@map("webhook_configs")
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  webhookId      String   @map("webhook_id")
  event          String
  payload        Json
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body")
  error          String?
  deliveredAt    DateTime @default(now()) @map("delivered_at")
  success        Boolean  @default(false)

  webhook WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, deliveredAt])
  @@map("webhook_deliveries")
}

model PushSubscription {
  id        String   @id
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model AuthLockout {
  key            String    @id
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastAttemptAt  DateTime  @map("last_attempt_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([lockedUntil])
  @@index([lastAttemptAt])
  @@map("auth_lockouts")
}

model OauthState {
  id          String   @id @default(uuid())
  stateHash   String   @unique @map("state_hash")
  redirectUri String?  @map("redirect_uri")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

model OauthCallbackCode {
  id        String   @id @default(uuid())
  codeHash  String   @unique @map("code_hash")
  userId    String   @map("user_id")
  provider  String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("oauth_callback_codes")
}

model NotificationEmailPreference {
  userId                  String   @id @map("user_id")
  enabled                 Boolean  @default(true)
  mentions                Boolean  @default(true)
  mentionsTiming          String   @default("immediate") @map("mentions_timing")
  ncrAssigned             Boolean  @default(true) @map("ncr_assigned")
  ncrAssignedTiming       String   @default("immediate") @map("ncr_assigned_timing")
  ncrStatusChange         Boolean  @default(true) @map("ncr_status_change")
  ncrStatusChangeTiming   String   @default("immediate") @map("ncr_status_change_timing")
  holdPointReminder       Boolean  @default(true) @map("hold_point_reminder")
  holdPointReminderTiming String   @default("immediate") @map("hold_point_reminder_timing")
  holdPointRelease        Boolean  @default(true) @map("hold_point_release")
  holdPointReleaseTiming  String   @default("immediate") @map("hold_point_release_timing")
  commentReply            Boolean  @default(true) @map("comment_reply")
  commentReplyTiming      String   @default("immediate") @map("comment_reply_timing")
  scheduledReports        Boolean  @default(true) @map("scheduled_reports")
  scheduledReportsTiming  String   @default("immediate") @map("scheduled_reports_timing")
  dailyDigest             Boolean  @default(false) @map("daily_digest")
  diaryReminder           Boolean  @default(true) @map("diary_reminder")
  diaryReminderTiming     String   @default("immediate") @map("diary_reminder_timing")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_email_preferences")
}

model NotificationDigestItem {
  id                        String    @id @default(uuid())
  userId                    String    @map("user_id")
  type                      String
  title                     String
  message                   String
  projectName               String?   @map("project_name")
  linkUrl                   String?   @map("link_url")
  sourceKey                 String?   @unique @map("source_key")
  createdAt                 DateTime  @default(now()) @map("created_at")
  deliveryFailureCount      Int       @default(0) @map("delivery_failure_count")
  lastDeliveryFailureAt     DateTime? @map("last_delivery_failure_at")
  lastDeliveryFailureReason String?   @map("last_delivery_failure_reason")
  nextAttemptAt             DateTime? @map("next_attempt_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, nextAttemptAt, createdAt], map: "digest_items_user_next_attempt_created_idx")
  @@index([nextAttemptAt, createdAt], map: "digest_items_next_attempt_created_idx")
  @@map("notification_digest_items")
}

model NotificationAlert {
  id              String    @id
  type            String
  severity        String
  title           String
  message         String
  entityId        String    @map("entity_id")
  entityType      String    @map("entity_type")
  projectId       String?   @map("project_id")
  assignedToId    String    @map("assigned_to_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")
  escalatedAt     DateTime? @map("escalated_at")
  escalationLevel Int       @default(0) @map("escalation_level")
  escalatedTo     Json?     @map("escalated_to")

  assignedTo User     @relation("AssignedNotificationAlerts", fields: [assignedToId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Plus a PARTIAL unique index Prisma cannot express: one ACTIVE alert per
  // (type, entity_id) — notification_alerts_active_type_entity_key, created in
  // migration 20260724070000_active_alert_unique_index with
  // WHERE resolved_at IS NULL. Alert creators must handle P2002.
  @@index([projectId, resolvedAt])
  @@index([assignedToId, resolvedAt])
  @@index([type, resolvedAt])
  @@map("notification_alerts")
}

model Project {
  id                  String    @id @default(uuid())
  companyId           String    @map("company_id")
  name                String
  projectNumber       String    @map("project_number")
  clientName          String?   @map("client_name")
  contractValue       Decimal?  @map("contract_value")
  startDate           DateTime? @map("start_date")
  targetCompletion    DateTime? @map("target_completion")
  status              String    @default("active")
  state               String
  specificationSet    String    @map("specification_set")
  // C1 gate strength (§5.1.2). Default 'warn' NEVER changes conformance
  // outcomes; 'block' is opt-in per project (§16 D1).
  testSufficiencyMode String    @default("warn") @map("test_sufficiency_mode")
  chainageStart       Decimal?  @map("chainage_start")
  chainageEnd         Decimal?  @map("chainage_end")
  lotPrefix           String?   @default("LOT-") @map("lot_prefix")
  lotStartingNumber   Int?      @default(1) @map("lot_starting_number")
  ncrPrefix           String?   @default("NCR-") @map("ncr_prefix")
  ncrStartingNumber   Int?      @default(1) @map("ncr_starting_number")
  settings            String? // Stored as JSON string for SQLite
  // Location for weather API
  latitude            Decimal?  @map("latitude")
  longitude           Decimal?  @map("longitude")
  // Working hours for notification timing
  workingHoursStart   String?   @default("07:00") @map("working_hours_start") // Format: HH:mm
  workingHoursEnd     String?   @default("17:00") @map("working_hours_end") // Format: HH:mm
  workingDays         String?   @default("1,2,3,4,5") @map("working_days") // Comma-separated: 0=Sun, 1=Mon, etc.
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company                     Company                            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projectUsers                ProjectUser[]
  projectAreas                ProjectArea[]
  controlLines                ControlLine[]
  planSheets                  PlanSheet[]
  lots                        Lot[]
  itpTemplates                ITPTemplate[]
  ncrs                        NCR[]
  dailyDiaries                DailyDiary[]
  subcontractorCompanies      SubcontractorCompany[]
  dailyDockets                DailyDocket[]
  progressClaims              ProgressClaim[]
  variations                  Variation[]
  documents                   Document[]
  drawings                    Drawing[]
  notifications               Notification[]
  notificationAlerts          NotificationAlert[]
  auditLogs                   AuditLog[]
  productEvents               ProductEvent[]
  testResults                 TestResult[]
  lotSubcontractorAssignments LotSubcontractorAssignment[]
  scheduledReports            ScheduledReport[]
  scheduledReportRuns         ScheduledReportRun[]
  scheduledReportDeliveries   ScheduledReportRecipientDelivery[]
  aiProposals                 AiProposal[]
  requirementEvaluations      RequirementEvaluation[]
  importBatches               ImportBatch[]
  importMappingProfiles       ImportMappingProfile[]
  folioSnapshots              FolioSnapshot[]
  folioIssueReservations      FolioIssueReservation[]
  folioIssues                 FolioIssue[]
  handoverExports             HandoverExport[]
  artifactLegalHolds          ArtifactLegalHold[]
  holdPointMailConsents       HoldPointMailConsent[]
  revisionIssues              RevisionIssue[]
  surveyRecords               SurveyRecord[]
  templateRevisionProposals   TemplateRevisionProposal[]

  @@unique([companyId, projectNumber])
  @@index([companyId, status])
  @@index([status, createdAt])
  @@map("projects")
}

model ProjectUser {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  userId     String    @map("user_id")
  role       String
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")
  status     String    @default("pending")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_users")
}

model ProjectArea {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  name          String
  chainageStart Decimal? @map("chainage_start")
  chainageEnd   Decimal? @map("chainage_end")
  colour        String?
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, chainageStart])
  @@map("project_areas")
}

// ============================================================================
// Spatial (control lines + lot geometry) — GeoJSON stored WGS84, turf in app code
// ============================================================================

model ControlLine {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  name             String
  coordinateSystem String   @map("coordinate_system") // EPSG code, e.g. "EPSG:7856" (GDA2020 MGA56)
  points           Json // ordered [{chainage, easting, northing}]
  geometryWgs84    Json?    @map("geometry_wgs84") // derived GeoJSON LineString cache
  createdById      String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("CreatedControlLines", fields: [createdById], references: [id], onDelete: SetNull)
  lotGeometries LotGeometry[]

  @@index([projectId])
  @@map("control_lines")
}

model LotGeometry {
  id            String   @id @default(uuid())
  lotId         String   @map("lot_id")
  kind          String // 'chainage_offset' | 'drawn' | 'point'
  controlLineId String?  @map("control_line_id") // for chainage_offset
  chainageStart Decimal? @map("chainage_start")
  chainageEnd   Decimal? @map("chainage_end")
  offsetLeft    Decimal? @map("offset_left") // metres left of control line
  offsetRight   Decimal? @map("offset_right") // metres right of control line
  geometryWgs84 Json     @map("geometry_wgs84") // GeoJSON Feature (Polygon/LineString/Point)
  areaM2        Decimal? @map("area_m2") // computed; user-overridable
  lengthM       Decimal? @map("length_m")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lot         Lot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  controlLine ControlLine? @relation(fields: [controlLineId], references: [id], onDelete: SetNull)

  @@index([lotId])
  @@map("lot_geometries")
}

// A georeferenced construction drawing page: the source PDF is pre-rastered to a
// PNG at upload and stored in the documents bucket; the viewer overlays lots on
// it using the affine `registration.transform`.
//
// Transform convention: transform = [a, b, c, d, e, f] maps image pixels
// (x right, y DOWN) to grid coords in `coordinateSystem`:
//   easting  = a*x + b*y + c
//   northing = d*x + e*y + f
// rmsErrorM = root-mean-square registration residual in metres. The math is
// computed client-side (later PR); the backend stores and validates it.
model PlanSheet {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  documentId       String?  @map("document_id") // optional source PDF Document
  name             String
  pageNumber       Int      @default(1) @map("page_number")
  imageRef         String   @map("image_ref") // supabase://documents/... (or local fallback path)
  imageWidth       Int      @map("image_width") // pixels
  imageHeight      Int      @map("image_height")
  coordinateSystem String   @map("coordinate_system") // EPSG preset, same set as ControlLine
  registration     Json? // {points:[{px,py,easting,northing}], transform:[a,b,c,d,e,f], rmsErrorM}
  perimeter        Json? // pixel-space ring [[x,y],...]
  createdById      String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("CreatedPlanSheets", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("plan_sheets")
}

// ============================================================================
// Lot Management
// ============================================================================

model Lot {
  id                        String    @id @default(uuid())
  projectId                 String    @map("project_id")
  lotNumber                 String    @map("lot_number")
  lotType                   String    @map("lot_type")
  description               String?
  chainageStart             Decimal?  @map("chainage_start")
  chainageEnd               Decimal?  @map("chainage_end")
  offset                    String?
  offsetCustom              String?   @map("offset_custom")
  layer                     String?
  areaZone                  String?   @map("area_zone")
  structureId               String?   @map("structure_id")
  structureElement          String?   @map("structure_element")
  activityType              String    @map("activity_type")
  // C1 [C1R-B6]: the FOLDED activity slug, stored. `activityType` is free text
  // (never constrained to CANONICAL_ACTIVITIES), so an index on it cannot serve a
  // folded-slug frequency-stream key: the fold is many-to-one through LEGACY_FOLD
  // and a CASE-INSENSITIVE LEGACY_FOLD_CI, and Postgres b-tree equality is
  // case-sensitive. NULL = fold confidence 'family' or 'none' (§16 D7). A
  // CLASSIFICATION, not a readiness verdict, so F0's no-stored-state doctrine
  // does not bite. Written by every path that writes activityType.
  activitySlug              String?   @map("activity_slug")
  // C1: the production quantity a per-quantity rule divides. NULL is first-class
  // and means "unknown" — never zero, never assumed (§7).
  quantityValue             Decimal?  @map("quantity_value")
  quantityUnit              String?   @map("quantity_unit")
  // C1: the testing scale the governing specification regiments by. Validated
  // against the resolved ruleset's `scaleKeys`; NULL falls back to
  // `ruleset.defaultScale` when the ruleset declares one (§16 D6), else unknown.
  testScale                 String?   @map("test_scale")
  // D14 §3.1: the authority's material classification for this lot — VicRoads
  // Type A / Type B / Type C, and whatever a future authority calls its classes.
  // FREE TEXT like `layer` and `areaZone`, NOT an enum: 'Type A' is VicRoads
  // vocabulary and a TfNSW or TMR pack would classify differently. The PACK
  // declares which strings it recognises (`Ruleset.materialTypes`) and the route
  // validates against them, so the column generalises while the values stay
  // authority-scoped. NULL = not recorded, and a material-scoped cap then simply
  // does not match (§3.4).
  materialType              String?   @map("material_type")
  status                    String    @default("not_started")
  itpTemplateId             String?   @map("itp_template_id")
  assignedSubcontractorId   String?   @map("assigned_subcontractor_id")
  budgetAmount              Decimal?  @map("budget_amount")
  createdById               String?   @map("created_by")
  conformedAt               DateTime? @map("conformed_at")
  conformedById             String?   @map("conformed_by")
  // Force-conformance override marker (owner/admin). Persisted so the claim
  // gate can distinguish a deliberate override from a later regression; kept
  // in sync with conformedAt/ById (set on force-conform, cleared on override
  // back to an operational status).
  conformanceOverriddenAt   DateTime? @map("conformance_overridden_at")
  conformanceOverriddenById String?   @map("conformance_overridden_by")
  conformanceOverrideReason String?   @map("conformance_override_reason")
  claimedInId               String?   @map("claimed_in_id")
  notes                     String?
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  project                 Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itpTemplate             ITPTemplate?          @relation(fields: [itpTemplateId], references: [id], onDelete: SetNull)
  assignedSubcontractor   SubcontractorCompany? @relation(fields: [assignedSubcontractorId], references: [id], onDelete: SetNull)
  createdBy               User?                 @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  conformedBy             User?                 @relation("ConformedByUser", fields: [conformedById], references: [id], onDelete: SetNull)
  conformanceOverriddenBy User?                 @relation("ConformanceOverriddenByUser", fields: [conformanceOverriddenById], references: [id], onDelete: SetNull)
  claimedIn               ProgressClaim?        @relation(fields: [claimedInId], references: [id], onDelete: SetNull)

  itpInstance              ITPInstance?
  holdPoints               HoldPoint[]
  holdPointReleaseBatches  HoldPointReleaseBatch[]
  testResults              TestResult[]
  ncrLots                  NCRLot[]
  documents                Document[]
  diaryActivities          DiaryActivity[]
  diaryDeliveries          DiaryDelivery[]
  surveyRecords            SurveyRecord[]
  diaryEvents              DiaryEvent[]
  diaryDelays              DiaryDelay[]
  diaryPlant               DiaryPlant[]
  diaryPersonnel           DiaryPersonnel[]
  docketLabourLots         DocketLabourLot[]
  docketPlantLots          DocketPlantLot[]
  claimedLots              ClaimedLot[]
  variations               Variation[]
  subcontractorAssignments LotSubcontractorAssignment[]
  geometries               LotGeometry[]
  folioSnapshots           FolioSnapshot[]
  folioIssueReservations   FolioIssueReservation[]
  folioIssues              FolioIssue[]
  governingRevisions       LotGoverningRevision[]

  @@unique([projectId, lotNumber])
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, conformedAt])
  @@index([createdById, createdAt], map: "lots_created_by_created_at_idx")
  // C1 [C1R-B6]: bounded frequency-stream lookback (§3.4.3), index-covered.
  // The existing @@index([projectId, conformedAt]) cannot serve it.
  @@index([projectId, activitySlug, conformedAt], map: "lots_project_activity_slug_conformed_idx")
  @@map("lots")
}

// ============================================================================
// ITP Management
// ============================================================================

model ITPTemplate {
  id                     String    @id @default(uuid())
  projectId              String?   @map("project_id")
  name                   String
  description            String?
  activityType           String?   @map("activity_type")
  specificationReference String?   @map("specification_reference")
  stateSpec              String?   @map("state_spec")
  version                Int       @default(1)
  isActive               Boolean   @default(true) @map("is_active")
  // Wave B: a human affirmed that this template's declared specification set is
  // right for its project. Until then an IMPORTED project-scoped template is
  // held out of Tier-A auto-fill (itpMatcher.routeTemplateMatch) — bulk import
  // must not manufacture 40 silent auto-fill candidates on one accept click.
  specAffirmedAt         DateTime? @map("spec_affirmed_at")
  specAffirmedById       String?   @map("spec_affirmed_by_id")

  // Wave G G2 (spec §2.2(a)) — the provenance that already existed in the
  // seeder header comments and was dropped on the way to the database. Every
  // column is nullable: the library asserts what its own file cites and nothing
  // more, so a template whose header states no edition keeps a null rather than
  // a guessed one.
  authority           String?   @map("authority") // 'TMR' | 'TfNSW' | 'VicRoads' | 'DIT' | 'MRWA' | 'Austroads' | 'WSA' | free text
  specEdition         String?   @map("spec_edition") // '04/10134' | 'March 2025' — as published, never normalised
  specIssuedOn        DateTime? @map("spec_issued_on")
  effectiveFrom       DateTime? @map("effective_from")
  reviewDueOn         DateTime? @map("review_due_on")
  changeSummary       String?   @map("change_summary")
  // §2.2(b): the shared annexure caveat. Seeder-set, never an AI judgement.
  annexureWarning     Boolean   @default(false) @map("annexure_warning")
  // §2.2(f) [GR-B3]: the GLOBAL library's own supersession chain, copying
  // `Drawing`'s shape (`schema.prisma` Drawing model). It records NO
  // `RevisionIssue` — that table is strictly project-scoped and a library
  // edition change is a library fact, not a transmittal to named recipients.
  supersededById      String?   @map("superseded_by_id")
  supersededAt        DateTime? @map("superseded_at")
  supersededBySeedRun String?   @map("superseded_by_seed_run")
  // §2.2(c): clone lineage. Deliberately NOT a foreign key — a corporate master
  // can be deleted and the copy's lineage must survive that, the same reasoning
  // `Comment.entityId` uses for keying without an FK.
  sourceTemplateId    String?   @map("source_template_id")
  // Import lineage DOES get an FK, because it can: `ImportBatch` rows are never
  // hard-deleted (the GC sweeps abandoned batches to `cancelled` and keeps
  // applied ones indefinitely — `importBatchGc.ts`), so `SetNull` fires only
  // when the whole project cascades away and takes the template with it. The FK
  // is what makes "traceable to its source document in ONE join" literally true.
  importBatchId       String?   @map("import_batch_id")

  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  project        Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItems ITPChecklistItem[]
  lots           Lot[]
  itpInstances   ITPInstance[]
  supersededBy   ITPTemplate?       @relation("ITPTemplateSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     ITPTemplate[]      @relation("ITPTemplateSupersedes")
  importBatch    ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // Wave G G5 (spec §5.3): proposals raised AGAINST this template, and the
  // proposals this template was created as the resolution OF.
  revisionProposals         TemplateRevisionProposal[] @relation("ProposalTemplate")
  resolvedRevisionProposals TemplateRevisionProposal[] @relation("ProposalResultingTemplate")

  @@unique([projectId, name, specEdition])
  @@index([projectId])
  @@index([projectId, supersededById])
  @@index([sourceTemplateId])
  @@index([importBatchId])
  @@map("itp_templates")
}

model ITPChecklistItem {
  id                 String  @id @default(uuid())
  templateId         String  @map("template_id")
  sequenceNumber     Int     @map("sequence_number")
  description        String
  acceptanceCriteria String? @map("acceptance_criteria")
  pointType          String  @default("standard") @map("point_type")
  responsibleParty   String  @default("contractor") @map("responsible_party")
  evidenceRequired   String  @default("none") @map("evidence_required")
  testType           String? @map("test_type")
  notes              String?
  // Wave G G2 (spec §2.2(c) [GR-A3]) — item-level lineage. Clone creates fresh
  // rows, so the same logical checklist item has a different id in every project
  // that adopted the template; without this, G5's cross-project recurrence
  // ("this item failed 7 times across 3 subcontractors") can only ever count
  // within one project's copy. Chains resolve by walking to the root. A null
  // pointer (every row created before G2) aggregates as its own root and is
  // reported as such — identity is NEVER guessed from description text.
  // No FK, for the same reason as ITPTemplate.sourceTemplateId.
  sourceChecklistItemId String? @map("source_checklist_item_id")

  template          ITPTemplate                @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itpCompletions    ITPCompletion[]
  holdPoints        HoldPoint[]
  testResults       TestResult[]
  ncrs              NCR[]
  revisionProposals TemplateRevisionProposal[] @relation("ProposalChecklistItem")

  @@index([templateId])
  @@index([sourceChecklistItemId])
  @@map("itp_checklist_items")
}

model ITPInstance {
  id               String   @id @default(uuid())
  lotId            String   @unique @map("lot_id")
  templateId       String   @map("template_id")
  templateSnapshot String?  @map("template_snapshot") // JSON snapshot of template at assignment time
  status           String   @default("not_started")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  lot         Lot             @relation(fields: [lotId], references: [id], onDelete: Cascade)
  template    ITPTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  completions ITPCompletion[]

  @@index([templateId])
  @@map("itp_instances")
}

model ITPCompletion {
  id                 String    @id @default(uuid())
  itpInstanceId      String    @map("itp_instance_id")
  checklistItemId    String    @map("checklist_item_id")
  status             String    @default("pending")
  completedById      String?   @map("completed_by")
  completedAt        DateTime? @map("completed_at")
  notes              String?
  signatureUrl       String?   @map("signature_url")
  witnessPresent     Boolean?  @map("witness_present")
  witnessName        String?   @map("witness_name")
  witnessCompany     String?   @map("witness_company")
  verificationStatus String    @default("none") @map("verification_status")
  verifiedById       String?   @map("verified_by")
  verifiedAt         DateTime? @map("verified_at")
  verificationNotes  String?   @map("verification_notes")
  gpsLatitude        Decimal?  @map("gps_latitude")
  gpsLongitude       Decimal?  @map("gps_longitude")

  itpInstance   ITPInstance      @relation(fields: [itpInstanceId], references: [id], onDelete: Cascade)
  checklistItem ITPChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  completedBy   User?            @relation("CompletedByUser", fields: [completedById], references: [id], onDelete: SetNull)
  verifiedBy    User?            @relation("VerifiedByUser", fields: [verifiedById], references: [id], onDelete: SetNull)

  attachments ITPCompletionAttachment[]

  @@unique([itpInstanceId, checklistItemId])
  @@index([itpInstanceId])
  @@index([verificationStatus])
  @@index([completedById, completedAt], map: "itp_completions_completed_by_completed_at_idx")
  @@map("itp_completions")
}

model ITPCompletionAttachment {
  id           String @id @default(uuid())
  completionId String @map("completion_id")
  documentId   String @map("document_id")

  completion ITPCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([completionId, documentId])
  @@map("itp_completion_attachments")
}

// ============================================================================
// Hold Points
// ============================================================================

model HoldPoint {
  id                   String    @id @default(uuid())
  lotId                String    @map("lot_id")
  itpChecklistItemId   String    @map("itp_checklist_item_id")
  pointType            String    @map("point_type")
  description          String?
  status               String    @default("pending")
  notificationSentAt   DateTime? @map("notification_sent_at")
  notificationSentTo   String?   @map("notification_sent_to")
  scheduledDate        DateTime? @map("scheduled_date")
  scheduledTime        String?   @map("scheduled_time")
  releasedByName       String?   @map("released_by_name")
  releasedByOrg        String?   @map("released_by_organisation")
  releasedAt           DateTime? @map("released_at")
  releaseMethod        String?   @map("release_method")
  releaseSignatureUrl  String?   @map("release_signature_url")
  releaseNotes         String?   @map("release_notes")
  evidencePackageUrl   String?   @map("evidence_package_url")
  chaseCount           Int       @default(0) @map("chase_count")
  lastChasedAt         DateTime? @map("last_chased_at")
  // Escalation fields
  isEscalated          Boolean   @default(false) @map("is_escalated")
  escalatedAt          DateTime? @map("escalated_at")
  escalatedById        String?   @map("escalated_by")
  escalatedTo          String?   @map("escalated_to") // JSON array of user IDs or roles
  escalationReason     String?   @map("escalation_reason")
  escalationResolved   Boolean   @default(false) @map("escalation_resolved")
  escalationResolvedAt DateTime? @map("escalation_resolved_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  lot              Lot                     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  itpChecklistItem ITPChecklistItem        @relation(fields: [itpChecklistItemId], references: [id], onDelete: Restrict)
  releaseTokens    HoldPointReleaseToken[]

  @@unique([lotId, itpChecklistItemId])
  @@index([lotId])
  @@index([lotId, status])
  @@index([status, createdAt])
  @@index([status, scheduledDate])
  @@map("hold_points")
}

// Hold Point Release Tokens for external superintendent release (Feature #23)
model HoldPointReleaseToken {
  id                  String    @id @default(uuid())
  holdPointId         String    @map("hold_point_id")
  batchId             String?   @map("batch_id")
  recipientEmail      String    @map("recipient_email")
  recipientName       String?   @map("recipient_name")
  /// Raw SQL CHECK constraint requires sha256:<64 lowercase hex>.
  token               String    @unique
  expiresAt           DateTime  @map("expires_at")
  /// Wave E2.1. First successful view of the public release page, never
  /// re-stamped. Read as one of the implied-consent proofs for the automated
  /// chase; see HoldPointMailConsent for the durable record, because this row
  /// is swept ~48 h after creation by the retention worker.
  openedAt            DateTime? @map("opened_at")
  usedAt              DateTime? @map("used_at")
  releasedByName      String?   @map("released_by_name")
  releasedByOrg       String?   @map("released_by_org")
  releaseSignatureUrl String?   @map("release_signature_url")
  releaseNotes        String?   @map("release_notes")
  createdAt           DateTime  @default(now()) @map("created_at")

  holdPoint HoldPoint              @relation(fields: [holdPointId], references: [id], onDelete: Cascade)
  batch     HoldPointReleaseBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  requirementEvaluations RequirementEvaluation[]

  @@index([batchId])
  /// Wave E2 (spec §4.2.8). `deleteMany({ where: { holdPointId, usedAt: null } })`
  /// runs on every release request and every chase, and every chase resolver
  /// read starts from `holdPointId`. E2 turns those from user-triggered to
  /// hourly-and-automatic, which is what makes an existing gap load-bearing.
  @@index([holdPointId])
  @@map("hold_point_release_tokens")
}

// A batch release request groups the per-hold-point tokens above under a single
// "review room" secure link. Its own token is a sha256:-prefixed hash, exactly
// like HoldPointReleaseToken.token (a DB leak never exposes usable links).
model HoldPointReleaseBatch {
  id                String    @id @default(uuid())
  lotId             String    @map("lot_id")
  recipientEmail    String    @map("recipient_email")
  recipientName     String?   @map("recipient_name")
  /// Raw SQL CHECK constraint requires sha256:<64 lowercase hex>.
  token             String    @unique
  expiresAt         DateTime  @map("expires_at")
  /// Wave E2.1. First successful view of the review room, never re-stamped.
  openedAt          DateTime? @map("opened_at")
  scheduledDate     DateTime? @map("scheduled_date")
  scheduledTime     String?   @map("scheduled_time")
  requestedByUserId String?   @map("requested_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  lot           Lot                     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  releaseTokens HoldPointReleaseToken[]

  @@index([lotId])
  @@map("hold_point_release_batches")
}

/// Wave E2.1 — what CIVOS knows about mailing ONE external hold-point recipient
/// on ONE project: whether they have ever opened a CIVOS link (the implied-
/// consent proof the automated chase is gated on) and whether they have asked
/// CIVOS to stop.
///
/// E.0 threat-model item 16 blocked a suppression TABLE and named the flip
/// condition that unblocks it: *"a recipient asking CIVOS directly to stop,
/// rather than bouncing — then a table becomes necessary, and it ships WITH a
/// retention policy in the same PR, not after."* The unsubscribe link this wave
/// adds is exactly that request, so the table ships, and its retention policy
/// ships with it (`RETENTION_POLICIES.holdPointMailConsent`).
///
/// It is a separate row and not a column on the token because the token is a
/// 48-hour capability that the retention sweep deletes
/// (`buildExpiredOrOldUsedHoldPointReleaseTokenWhere`) and the chase's own
/// `revokeSupersededChaseReleaseTokens` deletes sooner still. Consent evidence
/// on a row with that lifetime is evidence that is gone before it is read.
model HoldPointMailConsent {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  /// Normalized (trimmed, lowercased) per `normalizeRecipientEmail`, so casing
  /// variants of one human are one row (E.0 item 12a).
  email          String
  firstOpenedAt  DateTime? @map("first_opened_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  /// An unsubscribe is honoured GLOBALLY, so the read that enforces it is keyed
  /// on the address alone across every project.
  @@index([email])
  @@map("hold_point_mail_consents")
}

// ============================================================================
// Test Results
// ============================================================================

model TestResult {
  id                      String    @id @default(uuid())
  projectId               String    @map("project_id")
  lotId                   String?   @map("lot_id")
  itpChecklistItemId      String?   @map("itp_checklist_item_id")
  testType                String    @map("test_type")
  testRequestNumber       String?   @map("test_request_number")
  laboratoryName          String?   @map("laboratory_name")
  laboratoryReportNumber  String?   @map("laboratory_report_number")
  sampleDate              DateTime? @map("sample_date")
  sampleLocation          String?   @map("sample_location")
  testDate                DateTime? @map("test_date")
  resultDate              DateTime? @map("result_date")
  resultValue             Decimal?  @map("result_value")
  resultUnit              String?   @map("result_unit")
  testMethod              String?   @map("test_method")
  specificationMin        Decimal?  @map("specification_min")
  specificationMax        Decimal?  @map("specification_max")
  passFail                String    @default("pending") @map("pass_fail")
  certificateDocId        String?   @map("certificate_document_id")
  status                  String    @default("requested")
  enteredById             String?   @map("entered_by")
  enteredAt               DateTime? @map("entered_at")
  verifiedById            String?   @map("verified_by")
  verifiedAt              DateTime? @map("verified_at")
  /// Wave C2 Phase 3: system-stamped when the row transitions to 'at_lab'.
  /// Never user-editable, and deliberately NOT cleared by reject [C2R-A3] —
  /// rejecting a result does not un-send the sample.
  sentToLabAt             DateTime? @map("sent_to_lab_at")
  /// Wave C2 Phase 3: user-supplied, optional. CIVOS never defaults it (J5) —
  /// blank is the normal case, and blank shows elapsed days only.
  expectedResultDate      DateTime? @map("expected_result_date")
  /// Wave C3 Phase B1. Where the sample was taken, WGS84. Written ONLY from an
  /// explicit human capture (a map tap or a device GPS fix) [C3S-B1] — never
  /// derived from `sampleLocation` text, never defaulted to a lot centroid.
  /// Vocabulary validated against TfNSW LIMS v6 Table 1
  /// `SampleLocationChainageGPSCoordinates` (C3 spec §3.4).
  sampleLatitude          Decimal?  @map("sample_latitude")
  sampleLongitude         Decimal?  @map("sample_longitude")
  /// 'gps' | 'map_pick' — provenance of the pair above. NULL iff both are NULL.
  /// A future imported source adds a value here; it never overloads an existing
  /// one. Enforced by a CHECK constraint, mirrored by a Zod enum at the route.
  sampleLocationSource    String?   @map("sample_location_source")
  /// Metres, from the GPS fix that produced the pair. NULL for 'map_pick' and
  /// for any unlocated row. Unrecoverable after capture, which is why it is
  /// captured [C3R-A4] — a +/-40 m pin and a +/-4 m pin are different evidence.
  sampleLocationAccuracyM Decimal?  @map("sample_location_accuracy_m")
  rejectedById            String?   @map("rejected_by")
  rejectedAt              DateTime? @map("rejected_at")
  rejectionReason         String?   @map("rejection_reason")
  aiExtracted             Boolean   @default(false) @map("ai_extracted")
  aiConfidence            String?   @map("ai_confidence") // Stored as JSON string for SQLite
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lot              Lot?              @relation(fields: [lotId], references: [id], onDelete: SetNull)
  itpChecklistItem ITPChecklistItem? @relation(fields: [itpChecklistItemId], references: [id], onDelete: SetNull)
  certificateDoc   Document?         @relation(fields: [certificateDocId], references: [id], onDelete: SetNull)
  enteredBy        User?             @relation("EnteredByUser", fields: [enteredById], references: [id], onDelete: SetNull)
  verifiedBy       User?             @relation("VerifiedByTestUser", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy       User?             @relation("RejectedByTestUser", fields: [rejectedById], references: [id], onDelete: SetNull)
  linkedNcrs       NCR[]             @relation("NcrLinkedFailedTestResult")

  @@index([projectId])
  @@index([projectId, status])
  @@index([lotId])
  @@index([projectId, passFail])
  @@index([enteredById, createdAt], map: "test_results_entered_by_created_at_idx")
  @@map("test_results")
}

// ============================================================================
// NCR Management
// ============================================================================

model NCR {
  id                         String    @id @default(uuid())
  projectId                  String    @map("project_id")
  ncrNumber                  String    @map("ncr_number")
  description                String
  specificationReference     String?   @map("specification_reference")
  category                   String
  severity                   String    @default("minor") // minor, major
  status                     String    @default("open")
  linkedTestResultId         String?   @map("linked_test_result_id")
  qmApprovalRequired         Boolean   @default(false) @map("qm_approval_required")
  qmApprovedById             String?   @map("qm_approved_by")
  qmApprovedAt               DateTime? @map("qm_approved_at")
  raisedById                 String?   @map("raised_by")
  raisedAt                   DateTime  @default(now()) @map("raised_at")
  responsibleUserId          String?   @map("responsible_user_id")
  responsibleSubcontractorId String?   @map("responsible_subcontractor_id")
  dueDate                    DateTime? @map("due_date")
  rootCauseCategory          String?   @map("root_cause_category")
  rootCauseDescription       String?   @map("root_cause_description")
  proposedCorrectiveAction   String?   @map("proposed_corrective_action")
  responseSubmittedAt        DateTime? @map("response_submitted_at")
  rectificationNotes         String?   @map("rectification_notes")
  rectificationSubmittedAt   DateTime? @map("rectification_submitted_at")
  verifiedById               String?   @map("verified_by")
  verifiedAt                 DateTime? @map("verified_at")
  verificationNotes          String?   @map("verification_notes")
  closedById                 String?   @map("closed_by")
  closedAt                   DateTime? @map("closed_at")
  concessionJustification    String?   @map("concession_justification")
  concessionRiskAssessment   String?   @map("concession_risk_assessment")
  clientApprovalReference    String?   @map("client_approval_reference")
  clientNotificationRequired Boolean   @default(false) @map("client_notification_required")
  clientNotifiedAt           DateTime? @map("client_notified_at")
  lessonsLearned             String?   @map("lessons_learned")

  // Response fields
  response      String?   @map("response")
  respondedAt   DateTime? @map("responded_at")
  respondedById String?   @map("responded_by")

  // QM Review fields
  qmReviewedAt     DateTime? @map("qm_reviewed_at")
  qmReviewedById   String?   @map("qm_reviewed_by")
  qmReviewComments String?   @map("qm_review_comments")

  // Revision request fields
  revisionRequested   Boolean   @default(false) @map("revision_requested")
  revisionRequestedAt DateTime? @map("revision_requested_at")
  revisionCount       Int       @default(0) @map("revision_count")

  // Escalation fields
  escalatedAt      DateTime? @map("escalated_at")
  escalatedById    String?   @map("escalated_by")
  escalationReason String?   @map("escalation_reason")

  // Client idempotency key (H5). The offline sync worker sends its own stable
  // local NCR id; a retry after a dropped connection replays the original row
  // instead of raising a second NCR. Null for every online create.
  requestKey String? @map("request_key")

  // Wave G G5 (spec §5.3) — the failed-ITP-item link, first class.
  //
  // Before G5 the only artefact was a free-text marker `[itp-item:<id>]` inside
  // `rectificationNotes` (`routes/itp/instances/ncrLinks.ts`): regex-parsed,
  // unindexed, absent on legacy rows and absent entirely for NCRs raised
  // outside the failed-ITP path. Recurrence by checklist item is the whole
  // learning loop, and it cannot be built on a substring search.
  //
  // `SetNull`, not `Cascade`: deleting a checklist item must not delete the
  // record that work against it did not conform. The marker stays written too —
  // it is what the backfill reads, and removing it would break the shipped
  // "View NCR" breadcrumb reconstruction.
  itpChecklistItemId String? @map("itp_checklist_item_id")

  // Wave C5.4a §4.4 — which delivery this NCR is about. There is no
  // held-material state (RG-8): AU civil handles nonconforming material with
  // an NCR plus the prohibition on incorporating it, and CIVOS already enforces
  // that through `lotConformable`'s `noOpenNcrs` limb. All that was missing was
  // the pointer at the delivery.
  //
  // `SetNull` and the index both copy `linkedTestResultId` exactly: deleting a
  // delivery nulls the link and never cascades an NCR away.
  linkedDeliveryId String? @map("linked_delivery_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project                  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itpChecklistItem         ITPChecklistItem?     @relation(fields: [itpChecklistItemId], references: [id], onDelete: SetNull)
  respondedBy              User?                 @relation("RespondedByUser", fields: [respondedById], references: [id], onDelete: SetNull)
  qmReviewedBy             User?                 @relation("QMReviewedByUser", fields: [qmReviewedById], references: [id], onDelete: SetNull)
  escalatedBy              User?                 @relation("EscalatedByUser", fields: [escalatedById], references: [id], onDelete: SetNull)
  raisedBy                 User?                 @relation("RaisedByUser", fields: [raisedById], references: [id], onDelete: SetNull)
  responsibleUser          User?                 @relation("ResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  responsibleSubcontractor SubcontractorCompany? @relation(fields: [responsibleSubcontractorId], references: [id], onDelete: SetNull)
  linkedTestResult         TestResult?           @relation("NcrLinkedFailedTestResult", fields: [linkedTestResultId], references: [id], onDelete: SetNull)
  linkedDelivery           DiaryDelivery?        @relation("NcrLinkedDelivery", fields: [linkedDeliveryId], references: [id], onDelete: SetNull)
  verifiedBy               User?                 @relation("VerifiedByUser", fields: [verifiedById], references: [id], onDelete: SetNull)
  closedBy                 User?                 @relation("ClosedByUser", fields: [closedById], references: [id], onDelete: SetNull)
  qmApprovedBy             User?                 @relation("QMApprovedByUser", fields: [qmApprovedById], references: [id], onDelete: SetNull)

  ncrLots     NCRLot[]
  ncrEvidence NCREvidence[]

  @@unique([projectId, ncrNumber])
  // Offline-retry replay returns the original NCR, never a duplicate (H5).
  @@unique([projectId, requestKey])
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([projectId, category, status])
  @@index([projectId, itpChecklistItemId])
  @@index([linkedTestResultId])
  @@index([linkedDeliveryId])
  @@index([raisedById, raisedAt], map: "ncrs_raised_by_raised_at_idx")
  @@index([responsibleUserId, raisedAt], map: "ncrs_responsible_user_raised_at_idx")
  @@map("ncrs")
}

model NCRLot {
  id    String @id @default(uuid())
  ncrId String @map("ncr_id")
  lotId String @map("lot_id")

  ncr NCR @relation(fields: [ncrId], references: [id], onDelete: Cascade)
  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([ncrId, lotId])
  @@map("ncr_lots")
}

model NCREvidence {
  id           String   @id @default(uuid())
