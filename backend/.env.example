# Database - PostgreSQL connection string
# Connection pool: append ?connection_limit=10&pool_timeout=30 for production
DATABASE_URL="postgresql://user:password@localhost:5432/siteproof?schema=public"
# Disposable database used only by Prisma drift checks. Prisma may reset it.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/siteproof_shadow?schema=public"
# Vitest refuses non-local or non-disposable DATABASE_URL values unless this is explicitly true.
ALLOW_EXTERNAL_TEST_DATABASE=false

# Supabase / file storage
# Production requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY for durable storage.
# ALLOW_LOCAL_FILE_STORAGE is a development/test escape hatch only; production rejects it.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Optional for browser/client integrations; server uploads require the service role key in production.
SUPABASE_ANON_KEY=""
ALLOW_LOCAL_FILE_STORAGE=false

# Wave D `D1c.2` — handover archive storage, over Supabase's S3-compatible
# endpoint. The archive is streamed with S3 multipart because a streaming ZIP
# does not know its size until the last byte (spec §4.5.3).
# REQUIRED BY BOTH the API service (it serves the streamed download) and the
# handover export worker service. WITHOUT THEM THE WORKER REFUSES TO START in
# production — it never falls back to Railway's ephemeral disk (spec §10.3).
# Credentials come from Supabase → Project Settings → Storage → S3 access keys.
SUPABASE_S3_ENDPOINT="https://your-project.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-southeast-2"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
# Retention TTL for a completed archive (spec §10.5). 30 days is `D1c.0`'s
# declared modelling assumption, NOT a settled product number — §17.4 records
# the default as an open Jay decision, and longer retention is linear storage
# cost against the add-on's COGS line.
HANDOVER_EXPORT_TTL_DAYS=30

# JWT Authentication
JWT_SECRET="your-jwt-secret-min-32-chars"
# 32 random bytes encoded as 64 hex characters. Required in production for MFA/TOTP secret encryption.
ENCRYPTION_KEY="your-64-character-hex-encryption-key"
# Development/test escape hatch only. Do not enable in shared staging or production.
ALLOW_PLAINTEXT_SECRET_STORAGE=false

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@siteproof.app"
EMAIL_ENABLED=true
# Development/test only. Production requires a valid RESEND_API_KEY and will not mock delivery.
EMAIL_PROVIDER=resend
# Scheduled reports run automatically in production unless disabled.
SCHEDULED_REPORT_WORKER_ENABLED=true
SCHEDULED_REPORT_WORKER_INTERVAL_MS=60000
# Digest notification emails run automatically in production unless disabled.
NOTIFICATION_DIGEST_WORKER_ENABLED=true
NOTIFICATION_DIGEST_WORKER_INTERVAL_MS=900000
NOTIFICATION_DIGEST_TIME_OF_DAY="17:00"
# Notification reminder, backlog, system alert, and escalation automation.
NOTIFICATION_AUTOMATION_WORKER_ENABLED=true
NOTIFICATION_AUTOMATION_WORKER_INTERVAL_MS=3600000
DIARY_REMINDER_TIME_OF_DAY="17:00"
# Wave E canary: comma-separated project ids the stale-hold-point alert scan is
# allowed to run for. FAILS CLOSED — unset or blank means the scan is skipped
# for every project, so an E1 deploy is inert until projects are named here.
# Scopes ONLY that scan: overdue-NCR alerts, diary reminders, docket backlog and
# escalations are unaffected (the global kill switch above would take all of
# them down together, which is why this exists).
WAVE_E_STALE_ALERT_PROJECT_IDS=
# Data-retention sweep: deletes expired short-lived tokens (password-reset,
# email-verification, document signed-link, used/expired hold-point release) and
# processed sync-queue rows. Runs automatically in production unless disabled.
DATA_RETENTION_WORKER_ENABLED=true
DATA_RETENTION_WORKER_INTERVAL_MS=86400000

# Readiness decision snapshots (F0). When false/unset, decisions behave exactly
# as before and each decision's audit row records `changes.snapshotSkipped:true`
# so the evidence gap stays countable. When true, a snapshot write failure
# BLOCKS the decision. Flip only via the documented rollout (execution spec §9);
# turning it back off is an incident action, not a tuning knob.
# NOTE: production has run TRUE permanently since 2026-07-26 (rollout complete);
# false here is the local-dev default only.
READINESS_SNAPSHOTS_ENABLED=false

# Support contact info
SUPPORT_EMAIL="support@siteproof.com.au"
SUPPORT_PHONE=""
SUPPORT_PHONE_LABEL=""
SUPPORT_EMERGENCY_PHONE=""
SUPPORT_ADDRESS=""
SUPPORT_HOURS="Mon-Fri, 8am-6pm AEST"
SUPPORT_RESPONSE_CRITICAL="Within 2 hours"
SUPPORT_RESPONSE_STANDARD="Within 24 hours"
SUPPORT_RESPONSE_GENERAL="Within 48 hours"

# Push notifications
# Generate persistent keys once with /api/push/generate-vapid-keys in development.
# Production will not auto-generate throwaway keys.
# If VAPID keys are configured in production, VAPID_SUBJECT is required.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@siteproof.com"

# Anthropic AI
# Certificate extraction falls back to manual review when ANTHROPIC_API_KEY is not configured.
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"
ANTHROPIC_TEST_CERT_MODEL="claude-3-5-haiku-20241022"
ANTHROPIC_DOCUMENT_CLASS_MODEL="claude-3-5-haiku-20241022"

# Frontend URL (for CORS and email links)
# Production startup requires this to be a public HTTPS URL, not localhost.
FRONTEND_URL="http://localhost:5174"

# Public backend URL (for signed download links and uploaded media URLs)
# Production startup requires BACKEND_URL or API_URL to be a public HTTPS URL, not localhost.
BACKEND_URL="http://localhost:3001"
API_URL="http://localhost:3001"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Production Google OAuth redirect URI must also be public HTTPS.
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"
# Development only. Enables /api/auth/oauth/mock and missing-Google-client mock redirect.
ALLOW_MOCK_OAUTH=false

# Optional comma-separated exact domains whose registration emails are auto-verified.
# Leave blank in normal production. Intended only for controlled demo/sandbox QA domains.
VERIFICATION_BYPASS_EMAIL_DOMAINS=

# Server
PORT=3001
NODE_ENV=development
ERROR_LOG_TO_FILE=true
ERROR_LOG_MAX_BYTES=5242880
# Error monitoring (Sentry). SENTRY_DSN is REQUIRED in production; backend
# startup fails without it. Leave blank in local/dev to disable (no-op).
SENTRY_DSN=
# Optional. Defaults to NODE_ENV. Labels events by deploy environment.
SENTRY_ENVIRONMENT=
# Optional. Defaults to RAILWAY_GIT_COMMIT_SHA when available; tags the release.
SENTRY_RELEASE=
# Optional. Performance tracing sample rate (0..1). Defaults to 0 (errors only).
SENTRY_TRACES_SAMPLE_RATE=0

# Rate limiting
# Production defaults to the database-backed store so limits and lockouts work across instances.
# Set RATE_LIMIT_STORE=memory only for local/dev single-process use.
RATE_LIMIT_STORE=memory
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=50
VERIFICATION_RESEND_RATE_LIMIT_MAX=3
SUPPORT_RATE_LIMIT_MAX=10
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MS=900000
# Optional when JWT_SECRET is strong; if set in production, use a unique random value.
RATE_LIMIT_KEY_SALT=""

# Webhooks
WEBHOOK_DELIVERY_TIMEOUT_MS=10000

# Reverse proxy
# Use a bounded hop count behind Railway/CDN. Do not use TRUST_PROXY=true in production.
TRUST_PROXY=1
